    {
      "dot": "cyan",
      "title": "Ephemeral Browser Sessions",
      "items": [
        "A single Browserbase session is spun up per company research request",
        "Sessions are strictly hard-capped at 120s to prevent hanging compute",
        "Stagehand always closes the browser session in a finally block"
      ]
    },
    {
      "dot": "emerald",
      "title": "Fault-Tolerant Synthesis",
      "items": [
        "If a company website is inaccessible or blocked, errors are caught gracefully",
        "GPT-4o falls back to synthesizing intelligence from the job description itself",
        "The agent guarantees a structured dossier is always returned"
      ]
    },
    {
      "dot": "rose",
      "title": "Durable Trace & Audit",
      "items": [
        "Synthesized company research is stored directly in jobs.company_research",
        "Agent execution steps and errors are recorded in the agent_logs table",
        "Next.js revalidates cached server components on completion"
      ]
